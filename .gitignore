# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# secrets
firebase-service-account.json

# Ignore ad-hoc/debug APKs, but DO commit the canonical driver-app build
# (public/tms.apk, ~35MB — under GitHub's 100MB limit) so it deploys with the
# app via git instead of an out-of-band upload.
public/*.apk
!public/tms.apk
