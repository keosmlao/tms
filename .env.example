# PostgreSQL (primary — odg database)
PG_HOST=
PG_PORT=5432
PG_DATABASE=odg
PG_USER=postgres
PG_PASSWORD=

# PostgreSQL (secondary — odservice database)
PG_HOST_B=
PG_PORT_B=5432
PG_DATABASE_B=odservice
PG_USER_B=postgres
PG_PASSWORD_B=

# JWT Secret (generate a strong random string, e.g. `openssl rand -base64 32`)
JWT_SECRET=
SECURE_COOKIE=false

# Thai GPS Tracker
GPS_TRACKER_API_URL=https://apis.thaigpstracker.co.th
GPS_TRACKER_USER=
GPS_TRACKER_PASS=

# LINE Notify (optional)
LINE_NOTIFY_TOKEN=
LINE_ACCESS_TOKEN=

# Firebase Cloud Messaging (one of the three)
#   1. Inline JSON (preferred for prod, careful with shell escaping)
#   2. Base64-encoded JSON (safer for CI / Vercel envs)
#   3. firebase-service-account.json file at the project root (local dev only)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Customer auto-notify on dispatch (optional). When unset, no SMS is sent.
# {to} and {text} are filled in automatically ({text} URL-encoded).
SMS_GATEWAY_URL=
SMS_GATEWAY_METHOD=GET
# Public base for the customer tracking link in the SMS (defaults to prod).
PUBLIC_BASE_URL=https://tms.odienmall.com
