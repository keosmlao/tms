# PostgreSQL (primary — odg database)
PG_HOST=
PG_PORT=5432
PG_DATABASE=odg
PG_USER=postgres
PG_PASSWORD=

# PostgreSQL (secondary — odservice database)
PG_HOST_B=
PG_PORT_B=5432
PG_DATABASE_B=odservice
PG_USER_B=postgres
PG_PASSWORD_B=

# JWT Secret (generate a strong random string, e.g. `openssl rand -base64 32`)
JWT_SECRET=
SECURE_COOKIE=false

# Lao GPS Tracker — Open API v1 (ເສັ້ນທາງຫຼັກ)
# GET /positions ຄືນທຸກຄັນໃນ request ດຽວ ຈຶ່ງບໍ່ຕິດ 429 ຄືຂອງເກົ່າ.
# ໃຊ້ username/password ອັນດຽວກັບທີ່ເຂົ້າເວັບ gps.laogpstracker.com
GPS_OPENAPI_URL=https://gps.laogpstracker.com/api2/public/openapi/v1
GPS_OPENAPI_USER=
GPS_OPENAPI_PASS=

# Thai GPS Tracker (ຂອງເກົ່າ — ໃຊ້ເປັນຕົວສຳຮອງເມື່ອ Open API ຂ້າງເທິງລົ້ມ)
GPS_TRACKER_API_URL=https://apis.thaigpstracker.co.th
GPS_TRACKER_USER=
GPS_TRACKER_PASS=

# LINE Notify (optional)
LINE_NOTIFY_TOKEN=
LINE_ACCESS_TOKEN=

# Firebase Cloud Messaging (one of the three)
#   1. Inline JSON (preferred for prod, careful with shell escaping)
#   2. Base64-encoded JSON (safer for CI / Vercel envs)
#   3. firebase-service-account.json file at the project root (local dev only)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Customer auto-notify on dispatch (optional). When unset, no SMS is sent.
# {to} and {text} are filled in automatically ({text} URL-encoded).
SMS_GATEWAY_URL=
SMS_GATEWAY_METHOD=GET
# Public base for the customer tracking link in the SMS (defaults to prod).
PUBLIC_BASE_URL=https://tms.odienmall.com

# LINE customer notify: channel secret to verify the webhook signature.
# Webhook URL to set in the LINE console: <PUBLIC_BASE_URL>/api/line/webhook
LINE_CHANNEL_SECRET=
